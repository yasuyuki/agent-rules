{
  "comment": "Portable always-on rule and on-demand skill placement. conventions are file layouts; tools name CLIs and the conventions they read for each artifact kind.",
  "conventions": {
    "claude-rules-dir": {
      "path": ".claude/rules/agent-rules--{id}.md",
      "home_path": "rules/agent-rules--{id}.md"
    },
    "cursor-rules-dir": {
      "path": ".cursor/rules/agent-rules--{id}.mdc",
      "frontmatter": {
        "description": "@summary",
        "alwaysApply": "true"
      }
    },
    "agents-md-section": {
      "path": "AGENTS.md",
      "home_path": "AGENTS.md",
      "mode": "section"
    },
    "agents-rules-dir": {
      "path": ".agents/rules/agent-rules--{id}.md"
    },
    "claude-skills-dir": {
      "unit": "dir",
      "path": ".claude/skills/{id}",
      "home_path": "skills/{id}"
    },
    "cursor-skills-dir": {
      "unit": "dir",
      "path": ".cursor/skills/{id}",
      "home_path": "skills/{id}"
    },
    "agy-skills-dir": {
      "unit": "dir",
      "path": ".agents/skills/{id}",
      "home_path": "config/skills/{id}"
    },
    "codex-skills-dir": {
      "unit": "dir",
      "path": ".codex/skills/{id}",
      "home_path": "skills/{id}"
    }
  },
  "tools": {
    "claude": {
      "entrypoint": "claude",
      "credential": "$HOME/.claude/.credentials.json",
      "configHome": {
        "default": "$HOME/.claude",
        "env": "CLAUDE_CONFIG_DIR"
      },
      "reads": {
        "rules": ["claude-rules-dir"],
        "skills": ["claude-skills-dir"]
      },
      "hooks": {
        "kind": "settings",
        "path": "settings.json",
        "events": ["PreToolUse", "PostToolUse", "Stop", "SessionEnd"]
      }
    },
    "codex": {
      "entrypoint": "codex",
      "credential": "$HOME/.codex/auth.json",
      "configHome": {
        "default": "$HOME/.codex",
        "env": "CODEX_HOME"
      },
      "reads": {
        "rules": ["agents-md-section"],
        "skills": ["codex-skills-dir"]
      },
      "hooks": {
        "kind": "none",
        "reason": "CLI admits hooks (--dangerously-bypass-hook-trust) but no hooks file or documented path was found"
      }
    },
    "cursor-agent": {
      "entrypoint": "cursor-agent",
      "credential": "$config/cursor/auth.json",
      "configHome": {
        "default": "$HOME/.cursor"
      },
      "reads": {
        "rules": ["cursor-rules-dir"],
        "skills": ["cursor-skills-dir"]
      },
      "hooks": {
        "kind": "hooks.json",
        "path": "hooks.json",
        "events": ["observe", "block", "modify"]
      }
    },
    "agy": {
      "entrypoint": "agy",
      "credential": "$HOME/.gemini/antigravity-cli/antigravity-oauth-token",
      "configHome": {
        "default": "$HOME/.gemini"
      },
      "reads": {
        "rules": ["agents-md-section"],
        "skills": ["agy-skills-dir"]
      },
      "hooks": {
        "kind": "none",
        "reason": "agy --help has no hook surface; session check is the recording gate"
      }
    },
    "opencode": {
      "entrypoint": "opencode",
      "credential": "$data/opencode/auth.json",
      "configHome": {
        "default": "$HOME/.opencode"
      },
      "reads": {
        "rules": ["agents-md-section", "agents-rules-dir"],
        "skills": []
      },
      "hooks": {
        "kind": "none",
        "reason": "opencode --help has no hook surface; session check is the recording gate"
      }
    }
  }
}
