#!/usr/bin/env python3
"""Fixed dispatcher reached through an installed managed standard-name link."""
from __future__ import annotations

import importlib.util
from pathlib import Path
import sys


HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location("managed_entry", HERE / "managed_entry.py")
managed_entry = importlib.util.module_from_spec(spec)
spec.loader.exec_module(managed_entry)


def main(argv=None, invoked=None):
    invoked = Path(invoked if invoked is not None else sys.argv[0]).absolute()
    try:
        binding = managed_entry.load_binding(invoked.parent)
        tool = invoked.name
        if tool not in binding["tools"] or not invoked.is_symlink() or not managed_entry._same_file(invoked, binding["dispatcher"]):
            raise managed_entry.EntryError("managed entry link is stale or changed: %s" % invoked)
        # The adopted config carries vendor identity. Never import placement or
        # infer a replacement vendor from ambient PATH here.
        import subprocess
        import os
        command = [sys.executable, binding["place"], "standard-start",
                   "--config", binding["config"], tool, "--",
                   *(sys.argv[1:] if argv is None else argv)]
        if os.name == "posix":
            os.execv(sys.executable, command)
        return subprocess.run(command).returncode
    except managed_entry.EntryError as exc:
        print("FAIL: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
